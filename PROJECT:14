        "# Delivery and customer review relationship\n",
        "delivery_data = master[\n",
        "    (master[\"is_delivered\"] == 1) &\n",
        "    master[\"delay_days\"].notna() &\n",
        "    master[\"average_review\"].notna()\n",
        "].copy()\n",
        "\n",
        "delivery_data[\"delivery_group\"] = np.where(\n",
        "    delivery_data[\"delay_days\"] > 0,\n",
        "    \"Delayed\",\n",
        "    \"On Time\"\n",
        ")\n",
        "\n",
        "review_analysis = delivery_data.groupby(\n",
        "    \"delivery_group\"\n",
        ").agg(\n",
        "    total_orders=(\"order_id\", \"count\"),\n",
        "    average_review=(\"average_review\", \"mean\"),\n",
        "    average_delay=(\"delay_days\", \"mean\")\n",
        ").reset_index()\n",
        "\n",
        "display(review_analysis)\n",
        "\n",
        "# Correlation\n",
        "correlation = np.corrcoef(\n",
        "    delivery_data[\"delay_days\"],\n",
        "    delivery_data[\"average_review\"]\n",
        ")[0, 1]\n",
        "\n",
        "print(\"Delay-review correlation:\", round(correlation, 3))\n",
        "\n",
        "# Cancellation analysis\n",
        "cancellation_analysis = master.groupby(\n",
        "    \"order_status\"\n",
        ").agg(\n",
        "    total_orders=(\"order_id\", \"count\"),\n",
        "    average_payment=(\"total_payment\", \"mean\")\n",
        ").reset_index()\n",
        "\n",
        "display(cancellation_analysis)\n",
        "\n",
        "# Refund limitation\n",
        "print(\n",
        "    \"Note: Olist does not provide a dedicated refund transaction \"\n",
        "    \"table. Cancellations cannot be treated as confirmed refunds.\"\n",
        ")\n",
        "\n",
        "# Bootstrap confidence interval using NumPy\n",
        "def bootstrap_ci(values, iterations=1000):\n",
        "    x = pd.Series(values).dropna().to_numpy(dtype=float)\n",
        "\n",
        "    if len(x) < 2:\n",
        "        return np.nan, np.nan, np.nan\n",
        "\n",
        "    samples = np.random.choice(\n",
        "        x, (iterations, len(x)), replace=True\n",
        "    )\n",
        "\n",
        "    means = np.mean(samples, axis=1)\n",
        "\n",
        "    return (\n",
        "        np.mean(x),\n",
        "        np.percentile(means, 2.5),\n",
        "        np.percentile(means, 97.5)\n",
        "    )\n",
        "\n",
        "ontime_ci = bootstrap_ci(delivered[\"is_ontime\"])\n",
        "review_ci = bootstrap_ci(master[\"average_review\"])\n",
        "\n",
        "uncertainty_report = pd.DataFrame([\n",
        "    [\"On-time delivery rate\", *ontime_ci],\n",
        "    [\"Average review score\", *review_ci]\n",
        "], columns=[\n",
        "    \"Metric\", \"Estimate\", \"95% Lower\", \"95% Upper\"\n",
        "])\n",
        "\n",
        "display(uncertainty_report)"
