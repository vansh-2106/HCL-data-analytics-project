      "source": [
        "# Calculate delivery time and delay\n",
        "master[\"delivery_days\"] = (\n",
        "    master[\"order_delivered_customer_date\"] -\n",
        "    master[\"order_purchase_timestamp\"]\n",
        ").dt.total_seconds() / 86400\n",
        "\n",
        "master[\"delay_days\"] = (\n",
        "    master[\"order_delivered_customer_date\"] -\n",
        "    master[\"order_estimated_delivery_date\"]\n",
        ").dt.total_seconds() / 86400\n",
        "\n",
        "master[\"is_delayed\"] = (\n",
        "    master[\"delay_days\"] > 0\n",
        ").astype(int)\n",
        "\n",
        "master[\"is_cancelled\"] = (\n",
        "    master[\"order_status\"] == \"canceled\"\n",
        ").astype(int)\n",
        "\n",
        "master[\"is_delivered\"] = (\n",
        "    master[\"order_status\"] == \"delivered\"\n",
        ").astype(int)\n",
        "\n",
        "master[\"is_ontime\"] = (\n",
        "    (master[\"is_delivered\"] == 1) &\n",
        "    (master[\"delay_days\"] <= 0)\n",
        ").astype(int)\n",
        "\n",
        "# Overall KPIs\n",
        "delivered = master[master[\"is_delivered\"] == 1]\n",
        "\n",
        "print(\"TOTAL ORDERS:\", len(master))\n",
        "print(\"DELIVERED ORDERS:\", master[\"is_delivered\"].sum())\n",
        "\n",
        "print(\n",
        "    \"CANCELLATION RATE:\",\n",
        "    round(master[\"is_cancelled\"].mean() * 100, 2), \"%\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"ON-TIME DELIVERY RATE:\",\n",
        "    round(delivered[\"is_ontime\"].mean() * 100, 2), \"%\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"AVERAGE DELIVERY DAYS:\",\n",
        "    round(delivered[\"delivery_days\"].mean(), 2)\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"AVERAGE CUSTOMER REVIEW:\",\n",
        "    round(master[\"average_review\"].mean(), 2)\n",
        ")"
