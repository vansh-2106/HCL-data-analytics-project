      "cell_type": "code",
      "source": [
        "# Seller cohort analysis\n",
        "seller_scorecard[\"seller_cohort\"] = pd.qcut(\n",
        "    seller_scorecard[\"total_orders\"].rank(method=\"first\"),\n",
        "    q=3,\n",
        "    labels=[\"Small\", \"Medium\", \"Large\"]\n",
        ")\n",
        "\n",
        "cohort_analysis = seller_scorecard.groupby(\n",
        "    \"seller_cohort\", observed=True\n",
        ").agg(\n",
        "    total_sellers=(\"seller_id\", \"count\"),\n",
        "    average_orders=(\"total_orders\", \"mean\"),\n",
        "    average_revenue=(\"total_revenue\", \"mean\"),\n",
        "    average_review=(\"average_review\", \"mean\"),\n",
        "    average_score=(\"composite_score\", \"mean\")\n",
        ").reset_index()\n",
        "\n",
        "display(cohort_analysis)\n",
        "\n",
        "# Weight sensitivity testing\n",
        "scenarios = {\n",
        "    \"Balanced\": [0.35, 0.30, 0.20, 0.15],\n",
        "    \"Delivery Focus\": [0.50, 0.20, 0.20, 0.10],\n",
        "    \"Customer Focus\": [0.25, 0.45, 0.20, 0.10],\n",
        "    \"Revenue Focus\": [0.20, 0.20, 0.15, 0.45]\n",
        "}\n",
        "\n",
        "sensitivity = seller_scorecard[\n",
        "    [\"seller_id\"] + score_columns\n",
        "].copy()\n",
        "\n",
        "for name, scenario_weights in scenarios.items():\n",
        "\n",
        "    sensitivity[name] = (\n",
        "        sensitivity[score_columns]\n",
        "        .fillna(0.5)\n",
        "        .to_numpy() @ np.array(scenario_weights)\n",
        "    ) * 100\n",
        "\n",
        "    sensitivity[name + \"_rank\"] = (\n",
        "        sensitivity[name].rank(\n",
        "            ascending=False, method=\"min\"\n",
        "        )\n",
        "    )\n",
        "\n",
        "display(sensitivity.head(10))\n",
        "\n",
        "# Ranking stability\n",
        "rank_correlation = sensitivity[\n",
        "    list(scenarios.keys())\n",
        "].corr(method=\"spearman\")\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "sns.heatmap(\n",
        "    rank_correlation,\n",
        "    annot=True,\n",
        "    cmap=\"coolwarm\",\n",
        "    vmin=-1,\n",
        "    vmax=1\n",
        ")\n",
        "plt.title(\"Seller Ranking Stability\")\n",
        "plt.show()"
      ],
