        "# Convert dates\n",
        "date_columns = [\n",
        "    \"order_purchase_timestamp\",\n",
        "    \"order_delivered_customer_date\",\n",
        "    \"order_estimated_delivery_date\"\n",
        "]\n",
        "\n",
        "for col in date_columns:\n",
        "    orders[col] = pd.to_datetime(orders[col], errors=\"coerce\")\n",
        "\n",
        "# Remove duplicate records\n",
        "customers = customers.drop_duplicates(\"customer_id\")\n",
        "orders = orders.drop_duplicates(\"order_id\")\n",
        "products = products.drop_duplicates(\"product_id\")\n",
        "sellers = sellers.drop_duplicates(\"seller_id\")\n",
        "reviews = reviews.drop_duplicates(\"review_id\")\n",
        "items = items.drop_duplicates([\"order_id\", \"order_item_id\"])\n",
        "\n",
        "# Fill missing category names\n",
        "products[\"product_category_name\"] = (\n",
        "    products[\"product_category_name\"].fillna(\"Unknown\")\n",
        ")\n",
        "\n",
        "# Validate joins\n",
        "def check_join(left, right, key, join_name):\n",
        "    unmatched = (~left[key].isin(right[key])).sum()\n",
        "\n",
        "    return {\n",
        "        \"Join\": join_name,\n",
        "        \"Left Records\": len(left),\n",
        "        \"Unmatched Records\": int(unmatched),\n",
        "        \"Unmatched Percentage\": round(\n",
        "            unmatched / max(len(left), 1) * 100, 2\n",
        "        )\n",
        "    }\n",
        "\n",
        "join_report = pd.DataFrame([\n",
        "    check_join(orders, customers, \"customer_id\",\n",
        "               \"Orders - Customers\"),\n",
        "    check_join(items, orders, \"order_id\",\n",
        "               \"Items - Orders\"),\n",
        "    check_join(items, products, \"product_id\",\n",
        "               \"Items - Products\"),\n",
        "    check_join(items, sellers, \"seller_id\",\n",
        "               \"Items - Sellers\"),\n",
        "    check_join(payments, orders, \"order_id\",\n",
        "               \"Payments - Orders\"),\n",
        "    check_join(reviews, orders, \"order_id\",\n",
        "               \"Reviews - Orders\")\n",
        "])\n",
        "\n",
        "display(join_report)"
