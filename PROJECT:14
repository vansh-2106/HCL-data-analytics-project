        "# Distribution summaries using NumPy\n",
        "def distribution(data, column):\n",
        "    x = data[column].dropna().to_numpy(dtype=float)\n",
        "\n",
        "    # Safe check for empty arrays to prevent NumPy percentile errors\n",
        "    if len(x) == 0:\n",
        "        return {\n",
        "            \"Metric\": column,\n",
        "            \"Mean\": np.nan,\n",
        "            \"Median\": np.nan,\n",
        "            \"Standard Deviation\": np.nan,\n",
        "            \"25th Percentile\": np.nan,\n",
        "            \"75th Percentile\": np.nan,\n",
        "            \"95th Percentile\": np.nan\n",
        "        }\n",
        "\n",
        "    return {\n",
        "        \"Metric\": column,\n",
        "        \"Mean\": np.mean(x),\n",
        "        \"Median\": np.median(x),\n",
        "        \"Standard Deviation\": np.std(x),\n",
        "        \"25th Percentile\": np.percentile(x, 25),\n",
        "        \"75th Percentile\": np.percentile(x, 75),\n",
        "        \"95th Percentile\": np.percentile(x, 95)\n",
        "    }\n",
        "\n",
        "distribution_report = pd.DataFrame([\n",
        "    distribution(seller_scorecard, \"total_revenue\"),\n",
        "    distribution(seller_scorecard, \"average_review\"),\n",
        "    distribution(seller_scorecard, \"average_delay\"),\n",
        "    distribution(product_scorecard, \"total_revenue\")\n",
        "])\n",
        "\n",
        "display(distribution_report)\n",
        "\n",
        "# Robust normalization\n",
        "def normalize(series, higher_is_better=True):\n",
        "    x = series.astype(float)\n",
        "    if x.dropna().empty:\n",
        "        return pd.Series(0.5, index=x.index)\n",
        "    low, high = np.nanpercentile(x, [5, 95])\n",
        "\n",
        "    if high == low:\n",
        "        result = pd.Series(0.5, index=x.index)\n",
        "    else:\n",
        "        result = (x.clip(low, high) - low) / (high - low)\n",
        "\n",
        "    if not higher_is_better:\n",
        "        result = 1 - result\n",
        "\n",
        "    return result\n",
        "\n",
        "seller_scorecard[\"delivery_score\"] = normalize(\n",
        "    seller_scorecard[\"delivery_rate\"]\n",
        ")\n",
        "\n",
        "seller_scorecard[\"review_score\"] = (\n",
        "    seller_scorecard[\"average_review\"].fillna(2.5) / 5\n",
        ")\n",
        "\n",
        "seller_scorecard[\"cancellation_score\"] = normalize(\n",
        "    seller_scorecard[\"cancellation_rate\"],\n",
        "    False\n",
        ")\n",
        "\n",
        "seller_scorecard[\"revenue_score\"] = normalize(\n",
        "    seller_scorecard[\"total_revenue\"]\n",
        ")\n",
        "\n",
        "# Composite score\n",
        "weights = [0.35, 0.30, 0.20, 0.15]\n",
        "\n",
        "score_columns = [\n",
        "    \"delivery_score\",\n",
        "    \"review_score\",\n",
        "    \"cancellation_score\",\n",
        "    \"revenue_score\"\n",
        "]\n",
        "\n",
        "seller_scorecard[\"composite_score\"] = (\n",
        "    seller_scorecard[score_columns]\n",
        "    .fillna(0.5)\n",
        "    .to_numpy() @ np.array(weights)\n",
        ") * 100\n",
        "\n",
        "seller_scorecard = seller_scorecard.sort_values(\n",
        "    \"composite_score\", ascending=False\n",
        ")\n",
        "\n",
        "print(\"TOP 10 SELLERS\")\n",
        "display(seller_scorecard[\n",
        "    [\"seller_id\", \"total_orders\", \"total_revenue\",\n",
        "     \"delivery_rate\", \"average_review\",\n",
        "     \"composite_score\"]\n",
        "].head(10))"
