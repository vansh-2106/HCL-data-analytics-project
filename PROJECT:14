        "# Aggregate payment information\n",
        "payment_summary = payments.groupby(\"order_id\").agg(\n",
        "    total_payment=(\"payment_value\", \"sum\")\n",
        ").reset_index()\n",
        "\n",
        "# Aggregate review information\n",
        "review_summary = reviews.groupby(\"order_id\").agg(\n",
        "    average_review=(\"review_score\", \"mean\"),\n",
        "    review_count=(\"review_id\", \"count\")\n",
        ").reset_index()\n",
        "\n",
        "# Create master order dataset\n",
        "master = orders.merge(\n",
        "    customers[[\"customer_id\", \"customer_state\"]],\n",
        "    on=\"customer_id\",\n",
        "    how=\"left\",\n",
        "    validate=\"many_to_one\"\n",
        ")\n",
        "\n",
        "master = master.merge(\n",
        "    payment_summary,\n",
        "    on=\"order_id\",\n",
        "    how=\"left\",\n",
        "    validate=\"one_to_one\"\n",
        ")\n",
        "\n",
        "master = master.merge(\n",
        "    review_summary,\n",
        "    on=\"order_id\",\n",
        "    how=\"left\",\n",
        "    validate=\"one_to_one\"\n",
        ")\n",
        "\n",
        "# Create item-level dataset\n",
        "item_master = items.merge(\n",
        "    master,\n",
        "    on=\"order_id\",\n",
        "    how=\"left\",\n",
        "    validate=\"many_to_one\"\n",
        ")\n",
        "\n",
        "item_master = item_master.merge(\n",
        "    products,\n",
        "    on=\"product_id\",\n",
        "    how=\"left\",\n",
        "    validate=\"many_to_one\"\n",
        ")\n",
        "\n",
        "item_master = item_master.merge(\n",
        "    sellers,\n",
        "    on=\"seller_id\",\n",
        "    how=\"left\",\n",
        "    validate=\"many_to_one\"\n",
        ")\n",
        "\n",
        "print(\"Master datasets created!\")\n",
        "print(\"Orders:\", master.shape)\n",
        "print(\"Order items:\", item_master.shape)\n",
        "\n",
        "display(master.head())"
      ],
