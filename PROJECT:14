      "source": [
        "# Seller sales and order information\n",
        "seller_sales = item_master.groupby(\"seller_id\").agg(\n",
        "    total_items=(\"order_id\", \"count\"),\n",
        "    total_orders=(\"order_id\", \"nunique\"),\n",
        "    total_revenue=(\"price\", \"sum\")\n",
        ").reset_index()\n",
        "\n",
        "# One row per seller-order combination\n",
        "seller_orders = item_master[\n",
        "    [\"seller_id\", \"order_id\"]\n",
        "].drop_duplicates()\n",
        "\n",
        "seller_orders = seller_orders.merge(\n",
        "    master[[\n",
        "        \"order_id\", \"order_status\", \"is_delivered\",\n",
        "        \"is_cancelled\", \"is_ontime\", \"delay_days\",\n",
        "        \"average_review\"\n",
        "    ]],\n",
        "    on=\"order_id\",\n",
        "    how=\"left\"\n",
        ")\n",
        "\n",
        "# Seller operational performance\n",
        "seller_metrics = seller_orders.groupby(\"seller_id\").agg(\n",
        "    delivered_orders=(\"is_delivered\", \"sum\"),\n",
        "    cancelled_orders=(\"is_cancelled\", \"sum\"),\n",
        "    ontime_orders=(\"is_ontime\", \"sum\"),\n",
        "    average_review=(\"average_review\", \"mean\"),\n",
        "    average_delay=(\"delay_days\", \"mean\")\n",
        ").reset_index()\n",
        "\n",
        "seller_scorecard = seller_sales.merge(\n",
        "    seller_metrics,\n",
        "    on=\"seller_id\",\n",
        "    how=\"left\"\n",
        ")\n",
        "\n",
        "seller_scorecard[\"delivery_rate\"] = (\n",
        "    seller_scorecard[\"ontime_orders\"] /\n",
        "    seller_scorecard[\"delivered_orders\"].replace(0, np.nan)\n",
        ")\n",
        "\n",
        "seller_scorecard[\"cancellation_rate\"] = (\n",
        "    seller_scorecard[\"cancelled_orders\"] /\n",
        "    seller_scorecard[\"total_orders\"].replace(0, np.nan)\n",
        ")\n",
        "\n",
        "display(\n",
        "    seller_scorecard.sort_values(\n",
        "        \"total_revenue\", ascending=False\n",
        "    ).head(10)\n",
        ")"
      ],
