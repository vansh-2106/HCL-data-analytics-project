        "# Product scorecard\n",
        "product_scorecard = item_master.groupby(\n",
        "    [\"product_id\", \"product_category_name\"]\n",
        ").agg(\n",
        "    total_units=(\"order_id\", \"count\"),\n",
        "    total_orders=(\"order_id\", \"nunique\"),\n",
        "    total_revenue=(\"price\", \"sum\"),\n",
        "    average_price=(\"price\", \"mean\")\n",
        ").reset_index()\n",
        "\n",
        "# Attach customer ratings at order level\n",
        "product_reviews = item_master[\n",
        "    [\"product_id\", \"order_id\"]\n",
        "].drop_duplicates().merge(\n",
        "    master[[\"order_id\", \"average_review\"]],\n",
        "    on=\"order_id\",\n",
        "    how=\"left\"\n",
        ").groupby(\"product_id\").agg(\n",
        "    average_review=(\"average_review\", \"mean\")\n",
        ").reset_index()\n",
        "\n",
        "product_scorecard = product_scorecard.merge(\n",
        "    product_reviews,\n",
        "    on=\"product_id\",\n",
        "    how=\"left\"\n",
        ")\n",
        "\n",
        "# Category performance\n",
        "category_performance = item_master.groupby(\n",
        "    \"product_category_name\"\n",
        ").agg(\n",
        "    total_units=(\"product_id\", \"count\"),\n",
        "    total_orders=(\"order_id\", \"nunique\"),\n",
        "    total_revenue=(\"price\", \"sum\"),\n",
        "    average_price=(\"price\", \"mean\")\n",
        ").reset_index().sort_values(\n",
        "    \"total_revenue\", ascending=False\n",
        ")\n",
        "\n",
        "print(\"TOP PRODUCTS\")\n",
        "display(product_scorecard.nlargest(10, \"total_revenue\"))\n",
        "\n",
        "print(\"TOP CATEGORIES\")\n",
        "display(category_performance.head(10))"
